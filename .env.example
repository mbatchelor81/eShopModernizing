# ============================================================================
# eShopModernizing — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in the values before running docker-compose.
#
#   cp .env.example .env
#
# IMPORTANT: Never commit the `.env` file to source control.
# ============================================================================

# SQL Server SA password — used by all docker-compose services
SA_PASSWORD=<your-strong-password-here>

# Azure Storage connection string (optional — leave blank if not using Azure Storage)
ESHOP_AZURE_STORAGE_CONNECTION_STRING=

# Application Insights instrumentation key (optional)
APP_INSIGHTS_INSTRUMENTATION_KEY=

# Azure Active Directory settings (optional)
AZURE_ACTIVE_DIRECTORY_CLIENT_ID=
AZURE_ACTIVE_DIRECTORY_TENANT=

# External DNS name or IP for redirect URIs (defaults to 10.0.75.1)
ESHOP_EXTERNAL_DNS_NAME_OR_IP=

# Azure features (VM deployments only)
USE_AZURE_STORAGE=False
USE_AZURE_ACTIVE_DIRECTORY=false
