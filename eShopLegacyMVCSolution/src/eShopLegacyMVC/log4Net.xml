<log4net>
  <root>
    <level value="ALL" />
    <appender-ref ref="console" />
  </root>
  <!-- Console appender writes to stdout for container log aggregation -->
  <appender name="console" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %property{activity} %level %logger - %property{requestinfo}%newline%message%newline" />
    </layout>
  </appender>
</log4net>
