@model CatalogItem

@{
    ViewData["Title"] = "Details";
}

<h2>Details</h2>

<div class="container">
    <div class="row">
        @if (!string.IsNullOrEmpty(Model.PictureUri))
        {
            <div class="col-md-6">
                <img src="@Model.PictureUri" alt="@Model.Name" class="img-fluid" />
            </div>
        }
        <dl class="col-md-6 row">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8">@Model.Description</dd>

            <dt class="col-sm-4">Brand</dt>
            <dd class="col-sm-8">@Model.CatalogBrand?.Brand</dd>

            <dt class="col-sm-4">Type</dt>
            <dd class="col-sm-8">@Model.CatalogType?.Type</dd>

            <dt class="col-sm-4">Price</dt>
            <dd class="col-sm-8">@Model.Price.ToString("C")</dd>

            <dt class="col-sm-4">Picture File</dt>
            <dd class="col-sm-8">@Model.PictureFileName</dd>

            <dt class="col-sm-4">Available Stock</dt>
            <dd class="col-sm-8">@Model.AvailableStock</dd>

            <dt class="col-sm-4">Restock Threshold</dt>
            <dd class="col-sm-8">@Model.RestockThreshold</dd>

            <dt class="col-sm-4">Max Stock Threshold</dt>
            <dd class="col-sm-8">@Model.MaxStockThreshold</dd>
        </dl>
    </div>
    <p class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </p>
</div>
